	)
	(text "GPIO map of the Tiny Tapeout demo board firmware (GPIOMapTT06, tt-micropython-firmware v2.x):\nGP0 clk (RP_PROJCLK), GP1 rst_n (PROJECT_nRST), GP9 sel[0], GP10 sel[1], GP11 di_en (ui_in[2:0]),\nGP5-8 and GP13-16 count[7:0] (uo_out[7:0]), GP21 inv_dout (uio[0]).\nBoard use: GP18 SDA, GP19 SCL (I2C1), GP26-28 ADC of the buffered amp_vout, inv_vout, vtune.\nGP2-4 (the TT project mux) and GP12, GP17, GP20, GP22 are spare on the EXP header."
		(exclude_from_sim no)
		(at 17.78 116.84 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "8895984a-f0ff-5118-a8ed-d7e0b350a568")
	)
	(text "Defaults without the Pico: rst_n high, sel = 00, di_en low, no clock"
		(exclude_from_sim no)
		(at 13.97 143.51 0)
		(effects
