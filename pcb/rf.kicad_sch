	(text "VCO outputs: 0603 DC block, 0.21 mm GCPW (0.15 mm gaps, about 50 Ohm), end-launch SMA"
		(exclude_from_sim no)
		(at 26.67 26.67 0)
		(effects
			(font
				(size 1.778 1.778)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "d2037270-220b-52f1-b00a-c4926079b3ea")
	)
	(text "Reference line: the same launch, line and DC block twice, to measure the board path"
		(exclude_from_sim no)
		(at 26.67 100.33 0)
		(effects
			(font
				(size 1.778 1.778)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "c0673bfc-9e46-576f-953d-8e608daa8e79")
	)
	(text "The outputs are back-terminated with 50 Ohm to vdd_rf on the chip and sit at about 1.35 V: keep the DC blocks.\n20 GHz passes 1.3 mm bond wires and the package lead: expect 5 to 14 dB of path loss (hand estimate), so the SMAs\nserve frequency, tuning range and phase noise, not absolute output power. The reference line measures the board part.\nLine: 0.21 mm on F.Cu, 0.15 mm gaps, ground on In1.Cu 0.138 mm below (Aisler 4-layer), mask open, via fence at 0.8 mm."
		(exclude_from_sim no)
		(at 25.4 165.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "62ace93a-c3d0-51d7-af48-3f129fd33150")
	)
